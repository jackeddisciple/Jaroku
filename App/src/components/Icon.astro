{name === "sparkles" && (
  <svg {...base}><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2"/></svg>
)}
{name === "activity" && (
  <svg {...base}><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>
)}
{name === "layers" && (
  <svg {...base}><path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/><path d="M3 17l9 5 9-5"/></svg>
)}
{name === "git" && (
  <svg {...base}><circle cx="6" cy="18" r="2"/><circle cx="6" cy="6" r="2"/><circle cx="18" cy="12" r="2"/><path d="M6 8v8"/><path d="M6 12h10"/></svg>
)}
{name === "database" && (
  <svg {...base}><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
)}
{name === "bolt" && (
  <svg {...base}><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>
)}
{name === "terminal" && (
  <svg {...base}><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M13 15h5"/></svg>
)}
{name === "clock" && (
  <svg {...base}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
)}
{name === "users" && (
  <svg {...base}><circle cx="9" cy="9" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="8" r="2.5"/><path d="M15 20c0-2.8 2-5 5-5"/></svg>
)}
{name === "workspace" && (
  <svg {...base}><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 9h18"/><path d="M8 13h4"/></svg>
)}
{name === "key" && (
  <svg {...base}><circle cx="8" cy="12" r="4"/><path d="M12 12h9"/><path d="M17 12v3"/><path d="M20 12v2"/></svg>
)}
{name === "twitter" && (
  <svg {...base} fill="currentColor" stroke="none"><path d="M17.5 3H21l-7.4 8.5L22 21h-6.6l-5.2-6.4L4.2 21H1l7.9-9.1L1.6 3h6.7l4.7 5.9zM16.4 19.1h1.9L7.7 4.7H5.7z"/></svg>
)}
