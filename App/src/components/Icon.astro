---
// Inline SVG icons in the HugeIcons visual language: single-stroke, 1.75px, round joins.
// Kept in this file so an icon is a compile-time literal, not a runtime font or a hotlink.
// Add a new key here rather than pulling from the npm package — the package ships thousands
// of icons and the site uses a handful.
type IconName =
  | "graph" | "trace" | "cost" | "cloud" | "cockpit" | "lock" | "shield" | "eye"
  | "download" | "apple" | "windows" | "linux" | "external" | "arrow-right" | "arrow-up-right"
  | "chevron-down" | "chevron-right" | "check" | "close" | "search" | "menu"
  | "book" | "sparkles" | "activity" | "layers" | "git" | "database" | "bolt"
  | "terminal" | "shield-check" | "clock" | "users" | "workspace" | "key"
  | "twitter";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  ariaLabel?: string;
}
const {
  name,
  size = 20,
  class: className = "",
  strokeWidth = 1.75,
  ariaLabel,
} = Astro.props;

const base = {
  xmlns: "http://www.w3.org/2000/svg",
  width: size,
  height: size,
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": strokeWidth,
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  class: className,
  "aria-hidden": ariaLabel ? undefined : "true",
  role: ariaLabel ? "img" : undefined,
  "aria-label": ariaLabel,
};
---

{name === "graph" && (
  <svg {...base}>
    <circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="18" r="2"/><circle cx="12" cy="12" r="2"/>
    <path d="M6.5 7 10.5 11M13.5 11l4-4M6.5 17l4-4M13.5 13l4 4"/>
  </svg>
)}
{name === "trace" && (
  <svg {...base}>
    <path d="M3 6h4l1.5 4L11 6h4l1.5 4L19 6h2"/>
    <path d="M3 12h18"/>
    <path d="M3 18h5l1.2-2 2 4 1.6-4 1.4 2h6"/>
  </svg>
)}
{name === "cost" && (
  <svg {...base}>
    <circle cx="12" cy="12" r="9"/>
    <path d="M15 8.5a3 3 0 0 0-3-1.5c-1.7 0-3 1-3 2.4s1.6 1.9 3 2.2c1.4.3 3 .8 3 2.2S13.7 16 12 16a3 3 0 0 1-3-1.5"/>
    <path d="M12 5v2M12 16v2"/>
  </svg>
)}
{name === "cloud" && (
  <svg {...base}>
    <path d="M17 18H7a4 4 0 1 1 .8-7.9A6 6 0 0 1 19 12a4 4 0 0 1-2 6z"/>
    <path d="M9 14l3-3 3 3M12 11v6"/>
  </svg>
)}
{name === "cockpit" && (
  <svg {...base}>
    <rect x="3" y="4" width="18" height="14" rx="2"/>
    <path d="M3 9h18M8 13h2M8 15h6M14 13h2"/>
    <path d="M9 21h6"/>
  </svg>
)}
{name === "lock" && (
  <svg {...base}>
    <rect x="4" y="10" width="16" height="10" rx="2"/>
    <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    <circle cx="12" cy="15" r="1"/>
  </svg>
)}
{name === "shield" && (
  <svg {...base}>
    <path d="M12 3l8 3v6c0 4.5-3.4 8.4-8 9-4.6-.6-8-4.5-8-9V6l8-3z"/>
  </svg>
)}
{name === "shield-check" && (
  <svg {...base}>
    <path d="M12 3l8 3v6c0 4.5-3.4 8.4-8 9-4.6-.6-8-4.5-8-9V6l8-3z"/>
    <path d="M9 12l2 2 4-4"/>
  </svg>
)}
{name === "eye" && (
  <svg {...base}>
    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/>
    <circle cx="12" cy="12" r="3"/>
  </svg>
)}
{name === "download" && (
  <svg {...base}>
    <path d="M12 3v12"/><path d="M7 10l5 5 5-5"/><path d="M4 21h16"/>
  </svg>
)}
{name === "apple" && (
  <svg {...base} fill="currentColor" stroke="none">
    <path d="M16.4 12.5c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.9-.8-3.1-.8-1.6 0-3.1.9-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.6.8 1.2 1.7 2.5 3 2.4 1.2 0 1.6-.8 3.1-.8s1.9.8 3.1.8c1.3 0 2.1-1.2 2.9-2.3.6-.9 1-1.7 1.3-2.5-2.6-1-2.7-3.4-2.7-4.4zM14 5.5c.6-.7 1-1.8.9-2.8-.9 0-2 .6-2.6 1.3-.6.6-1.1 1.7-1 2.7 1 .1 2-.5 2.7-1.2z"/>
  </svg>
)}
{name === "windows" && (
  <svg {...base} fill="currentColor" stroke="none">
    <path d="M3 5.5L11 4.4v7.1H3zM12 4.3L21 3v8.5h-9zM3 12.5h8v7.1L3 18.5zM12 12.5h9V21l-9-1.3z"/>
  </svg>
)}
{name === "linux" && (
  <svg {...base}>
    <path d="M12 3c-1.7 0-3 1.6-3 3.5 0 1 .3 1.8.6 2.4-1.4 1-2.4 2.6-2.8 4.5-.3 1.3-.1 2.4.4 3.3.5.8.4 1.6-.2 2.3-.5.5-.4 1 .2 1h13c.6 0 .7-.5.2-1-.6-.7-.7-1.5-.2-2.3.5-.9.7-2 .4-3.3-.4-1.9-1.4-3.5-2.8-4.5.3-.6.6-1.4.6-2.4C15 4.6 13.7 3 12 3z"/>
    <circle cx="10.5" cy="7" r=".5" fill="currentColor"/><circle cx="13.5" cy="7" r=".5" fill="currentColor"/>
  </svg>
)}
{name === "external" && (
  <svg {...base}><path d="M14 4h6v6"/><path d="M20 4L10 14"/><path d="M20 14v6H4V4h6"/></svg>
)}
{name === "arrow-right" && (
  <svg {...base}><path d="M4 12h16"/><path d="M14 6l6 6-6 6"/></svg>
)}
{name === "arrow-up-right" && (
  <svg {...base}><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
)}
{name === "chevron-down" && (
  <svg {...base}><path d="M6 9l6 6 6-6"/></svg>
)}
{name === "chevron-right" && (
  <svg {...base}><path d="M9 6l6 6-6 6"/></svg>
)}
{name === "check" && (
  <svg {...base}><path d="M5 12l5 5L20 7"/></svg>
)}
{name === "close" && (
  <svg {...base}><path d="M6 6l12 12M18 6L6 18"/></svg>
)}
{name === "search" && (
  <svg {...base}><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
)}
{name === "menu" && (
  <svg {...base}><path d="M4 7h16M4 12h16M4 17h16"/></svg>
)}
{name === "book" && (
  <svg {...base}><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19a2 2 0 0 1 2-2h13"/></svg>
