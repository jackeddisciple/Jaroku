# Python
__pycache__/
*.py[cod]
.venv/
runtime/.venv/
*.egg-info/

# Node
node_modules/
server/node_modules/
dist/

# Data / secrets
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Generated agent projects are runtime output, not source. The hand-written
# reference agent is kept; everything else (and the staging dir) is ignored.
runtime/agents/*
!runtime/agents/__init__.py
!runtime/agents/example_agent/

# OS / editor
.DS_Store
*.log

# Private product documentation — kept local, not published
jaroku-product-documentation*.md

# Debug-depth checkpoints (durable LangGraph checkpoints per run; control-plane, not tracked)
runtime/.checkpoints/

# The local object store. Agent versions, staging copies and exports live here when
# JAROKU_OBJECT_STORE=fs, which is the default — the same bytes S3 holds when it is not.
# Runtime output, exactly like the generated projects above.
runtime/.objects/

# The key that signs local presigned object URLs. Generated on first use, chmod 600, and
# never anybody else's — see server/src/storage/presign.ts for why it is persisted rather
# than minted per process.
server/.objectkey

# The local development issuer's signing key. Real, chmod 600, and never anybody else's —
# it exists so `npm run dev` has authentication without a cloud account, and it must not
# travel with the repository. See server/src/auth/config.ts for why this is a real issuer
# rather than a flag that skips verification.
server/.devauth.json

# The key that signs run tokens locally — same reasoning as .objectkey, one level up the
# stack: see server/src/sandbox/runTokens.ts.
server/.runtokenkey
