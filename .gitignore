# Python
__pycache__/
*.py[cod]
.venv/
runtime/.venv/
*.egg-info/

# Node
node_modules/
server/node_modules/
dist/

# Data / secrets
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.env
.env.*
!.env.example

# Generated agent projects are runtime output, not source. The hand-written
# reference agent is kept; everything else (and the staging dir) is ignored.
runtime/agents/*
!runtime/agents/__init__.py
!runtime/agents/example_agent/

# OS / editor
.DS_Store
*.log

# Private product documentation — kept local, not published
jaroku-product-documentation*.md
# The implementation prompts, for the same reason. A specification is what the work was written
# against; the work itself, and the changelog entry that summarises it, are what ship.
#
# TWO PATTERNS, because the prompts have not been named consistently. The originals arrived as
# `jaroku-<feature>-prompt.pdf`; the Inbox tab's arrived as `inbox_tab.pdf`. A rule that only
# matched the first shape would have let the second one into a commit, which is how a private
# specification ends up published — so the destination's own name is matched too rather than the
# file being renamed to suit the rule.
jaroku-*-prompt.pdf
*_tab.pdf

# Cygwin drops one of these beside the repo when a bash process faults on Windows. It is a core
# dump with a stack trace in it, not source, and it reappears whenever the shell falls over.
*.stackdump

# Debug-depth checkpoints (durable LangGraph checkpoints per run; control-plane, not tracked)
runtime/.checkpoints/

# The local object store. Agent versions, staging copies and exports live here when
# JAROKU_OBJECT_STORE=fs, which is the default — the same bytes S3 holds when it is not.
# Runtime output, exactly like the generated projects above.
runtime/.objects/

# The key that signs local presigned object URLs. Generated on first use, chmod 600, and
# never anybody else's — see server/src/storage/presign.ts for why it is persisted rather
# than minted per process.
server/.objectkey

# The local development issuer's signing key. Real, chmod 600, and never anybody else's —
# it exists so `npm run dev` has authentication without a cloud account, and it must not
# travel with the repository. See server/src/auth/config.ts for why this is a real issuer
# rather than a flag that skips verification.
server/.devauth.json

# The key that signs run tokens locally — same reasoning as .objectkey, one level up the
# stack: see server/src/sandbox/runTokens.ts.
server/.runtokenkey

# The desktop wrapper's build output and its staged payloads.
#
# `target/` is Rust's, `gen/` is Tauri's generated schemas and platform projects. The other two
# are the reason this block is longer than one line: `binaries/` holds the Node runtime staged as
# a Tauri sidecar and `resources/` holds the Python runtime staged for the bundle, and both are
# HUNDREDS OF MEGABYTES OF SOMEBODY ELSE'S RELEASE ARTEFACTS. They are produced by
# scripts/tauri/prepare-*.mjs from a pinned version, so they are reproducible rather than
# precious — which is exactly the thing a repository should not be carrying.
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/
src-tauri/resources/
